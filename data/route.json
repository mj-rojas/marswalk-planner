 "pois": [
  {
   "id": "base",
   "role": "Shelter",
   "name": "Crew base",
   "lat": 18.512843,
   "lon": 77.324279,
   "elev_m": -2354.7,
   "dist_m": 0,
   "text": "Flat ground: every slope within 200 m is under 5°. The planner picked it as the flat site with the easiest walk to the science goal."
  },
  {
   "id": "ramp",
   "role": "Orientation",
   "name": "Neretva Vallis ramp",
   "lat": 18.497996,
   "lon": 77.314764,
   "elev_m": -2364.3,
   "dist_m": 1065.8,
   "text": "The route drops about 20 m into the ancient river channel through a gap in the valley wall (9.3° at its steepest). The channel is about 400 m wide: follow the foot of its north wall to the west."
  },
  {
   "id": "wall",
   "role": "Safety",
   "name": "Valley wall: no-go",
   "lat": 18.497977,
   "lon": 77.305859,
   "elev_m": -2339.5,
   "dist_m": null,
   "text": "The straight line from the base crosses 350 m of slopes over 10° and peaks at 20.4° here, over the 20° limit of the suit. A 20 m grid smooths real scarps, so the wall is likely steeper. The route goes around: 234 m longer, but only 48 m over 10°."
  },
  {
   "id": "goal",
   "role": "Science goal",
   "name": "Cheyava Falls",
   "lat": 18.49748,
   "lon": 77.30519,
   "elev_m": -2352.1,
   "dist_m": 1654,
   "text": "A 1 m rock with \"leopard spots\" (the minerals vivianite and greigite): a potential biosignature found by Perseverance in July 2024. Not confirmed: non-biological origins are not ruled out. Crew task: map how far the spots extend, choose the best samples and carry them back. The last metres climb at up to 15.8°.",
   "photo": {
    "src": "img/cheyava-falls-PIA26368.jpg",
    "alt": "Close-up of the rock Cheyava Falls: white veins and a reddish band with small dark-ringed spots",
    "caption": "Cheyava Falls, photographed by Perseverance on 18 July 2024.",
    "credit": "NASA/JPL-Caltech/MSSS · PIA26368",
    "url": "https://science.nasa.gov/photojournal/perseverance-finds-a-rock-with-leopard-spots/"
   }
  },
  {
   "id": "depot",
   "role": "Out of range",
   "name": "Three Forks depot: no-go",
   "lat": 18.45272,
   "lon": 77.40807,
   "elev_m": -2546.6,
   "dist_m": null,
   "text": "Perseverance left 10 sample tubes here (depot completed on 28 January 2023). It is 5.9 km from the base in a straight line: an emergency walkback of at least 100 min, over the 1 h design case (60 min). No-go on foot from this base: it needs a rover or a closer base. The position is the rover's waypoint while it built the depot (sols 652–686), not the position of each tube."
  }
 ],
